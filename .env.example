# Copy to .env (git-ignored) and fill in. Never commit real values.

# RunPod API key (RunPod console -> Settings -> API Keys)
RUNPOD_API_KEY=
# ID of the RunPod network volume holding models/LoRAs (must be in the configured datacenter)
RUNPOD_VOLUME_ID=
# Hugging Face token for downloading gated models (e.g. FLUX.1-dev)
HF_TOKEN=
