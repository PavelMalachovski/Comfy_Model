{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "hidream_o1_image_bf16.safetensors"
    }
  },
  "2": {
    "class_type": "ModelNoiseScale",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "noise_scale": 8
    }
  },
  "3": {
    "class_type": "HiDreamO1PatchSeamSmoothing",
    "inputs": {
      "model": [
        "2",
        0
      ],
      "start_percent": 0.8,
      "end_percent": 1,
      "pattern": "single_shift",
      "passes": "ramp_2_4",
      "blend": "median",
      "strength": 1
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}",
      "clip": [
        "1",
        1
      ]
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": [
        "1",
        1
      ]
    }
  },
  "6": {
    "class_type": "EmptyHiDreamO1LatentImage",
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "batch_size": 1
    }
  },
  "7": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": [
        "2",
        0
      ],
      "scheduler": "normal",
      "steps": 40,
      "denoise": 1
    }
  },
  "8": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "dpmpp_2m_sde_gpu"
    }
  },
  "9": {
    "class_type": "SamplerCustom",
    "inputs": {
      "model": [
        "3",
        0
      ],
      "add_noise": true,
      "noise_seed": "{{seed}}",
      "cfg": 5,
      "positive": [
        "4",
        0
      ],
      "negative": [
        "5",
        0
      ],
      "sampler": [
        "8",
        0
      ],
      "sigmas": [
        "7",
        0
      ],
      "latent_image": [
        "6",
        0
      ]
    }
  },
  "10": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "9",
        0
      ],
      "vae": [
        "1",
        2
      ]
    }
  },
  "20": {
    "class_type": "UltralyticsDetectorProvider",
    "_meta": {
      "title": "Face bbox detector (Impact Subpack)"
    },
    "inputs": {
      "model_name": "bbox/face_yolov8m.pt"
    }
  },
  "21": {
    "class_type": "FaceDetailer",
    "inputs": {
      "image": [
        "10",
        0
      ],
      "model": [
        "3",
        0
      ],
      "clip": [
        "1",
        1
      ],
      "vae": [
        "1",
        2
      ],
      "positive": [
        "4",
        0
      ],
      "negative": [
        "5",
        0
      ],
      "bbox_detector": [
        "20",
        0
      ],
      "guide_size": 768,
      "guide_size_for": true,
      "max_size": 1024,
      "seed": "{{seed}}",
      "steps": 20,
      "cfg": 5,
      "sampler_name": "dpmpp_2m_sde_gpu",
      "scheduler": "normal",
      "denoise": 0.35,
      "feather": 5,
      "noise_mask": true,
      "force_inpaint": true,
      "bbox_threshold": 0.5,
      "bbox_dilation": 10,
      "bbox_crop_factor": 1.6,
      "sam_detection_hint": "center-1",
      "sam_dilation": 0,
      "sam_threshold": 0.93,
      "sam_bbox_expansion": 0,
      "sam_mask_hint_threshold": 0.7,
      "sam_mask_hint_use_negative": "False",
      "drop_size": 10,
      "wildcard": "",
      "cycle": 1,
      "inpaint_model": false,
      "noise_mask_feather": 20,
      "tiled_encode": false,
      "tiled_decode": false,
      "detailer_hook": [
        "24",
        0
      ]
    }
  },
  "22": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "21",
        0
      ],
      "filename_prefix": "{{filename_prefix}}"
    }
  },
  "23": {
    "class_type": "SaveImage",
    "_meta": {
      "title": "Refined face crop at 100%"
    },
    "inputs": {
      "images": [
        "21",
        1
      ],
      "filename_prefix": "{{filename_prefix_face}}"
    }
  },
  "24": {
    "class_type": "CoreMLDetailerHookProvider",
    "_meta": {
      "title": "Forces a crop size divisible by 32 (HiDream-O1 has no patch padding)"
    },
    "inputs": {
      "mode": "768x768"
    }
  }
}
