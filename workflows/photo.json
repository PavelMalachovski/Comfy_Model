{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": {"title": "Load FLUX.1-dev fp8 (all-in-one)"},
    "inputs": {"ckpt_name": "flux1-dev-fp8.safetensors"}
  },
  "2": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": {"title": "Persona LoRA"},
    "inputs": {"model": ["1", 0], "lora_name": "{{lora_name}}", "strength_model": "{{lora_strength}}"}
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Positive prompt"},
    "inputs": {"text": "{{prompt}}", "clip": ["1", 1]}
  },
  "4": {
    "class_type": "FluxGuidance",
    "inputs": {"conditioning": ["3", 0], "guidance": 2.5}
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Empty negative (ignored at cfg 1.0)"},
    "inputs": {"text": "", "clip": ["1", 1]}
  },
  "6": {
    "class_type": "EmptySD3LatentImage",
    "inputs": {"width": "{{width}}", "height": "{{height}}", "batch_size": 1}
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["2", 0],
      "seed": "{{seed}}",
      "steps": 28,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "beta",
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["6", 0],
      "denoise": 1.0
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["7", 0], "vae": ["1", 2]}
  },
  "9": {
    "class_type": "UltralyticsDetectorProvider",
    "_meta": {"title": "Face bbox detector (Impact Subpack)"},
    "inputs": {"model_name": "bbox/face_yolov8m.pt"}
  },
  "10": {
    "class_type": "FaceDetailer",
    "_meta": {"title": "FaceDetailer (Impact Pack)"},
    "inputs": {
      "image": ["8", 0],
      "model": ["2", 0],
      "clip": ["1", 1],
      "vae": ["1", 2],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "bbox_detector": ["9", 0],
      "guide_size": 512,
      "guide_size_for": true,
      "max_size": 1024,
      "seed": "{{seed}}",
      "steps": 20,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "beta",
      "denoise": 0.35,
      "feather": 5,
      "noise_mask": true,
      "force_inpaint": true,
      "bbox_threshold": 0.5,
      "bbox_dilation": 10,
      "bbox_crop_factor": 3.0,
      "sam_detection_hint": "center-1",
      "sam_dilation": 0,
      "sam_threshold": 0.93,
      "sam_bbox_expansion": 0,
      "sam_mask_hint_threshold": 0.7,
      "sam_mask_hint_use_negative": "False",
      "drop_size": 10,
      "wildcard": "",
      "cycle": 1,
      "inpaint_model": false,
      "noise_mask_feather": 20,
      "tiled_encode": false,
      "tiled_decode": false
    }
  },
  "11": {
    "class_type": "UpscaleModelLoader",
    "inputs": {"model_name": "RealESRGAN_x4plus.pth"}
  },
  "12": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": {"upscale_model": ["11", 0], "image": ["10", 0]}
  },
  "13": {
    "class_type": "ImageScaleBy",
    "_meta": {"title": "4x model upscale, then 0.5 = net 2x"},
    "inputs": {"image": ["12", 0], "upscale_method": "lanczos", "scale_by": 0.5}
  },
  "14": {
    "class_type": "SaveImage",
    "inputs": {"images": ["13", 0], "filename_prefix": "{{filename_prefix}}"}
  }
}
